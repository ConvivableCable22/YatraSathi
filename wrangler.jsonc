{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yatrasathi",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": [
      "/",
      "/api/*"
    ]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yatrasathi-db",
      "database_id": "db8da959-c7ee-49f0-80a4-ea84e82873a7",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "EMAIL_QUEUE",
        "queue": "yatrasathi-email-queue"
      }
    ],
    "consumers": [
      {
        "queue": "yatrasathi-email-queue",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "yatrasathi-email-dlq"
      },
      {
        "queue": "yatrasathi-email-dlq",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3
      }
    ]
  },
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "ratelimits": [
    {
      "name": "RESET_IP_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "vars": {
    "APP_BASE_URL": "https://yatrasathi.aceaj.workers.dev",
    "CF_EMAIL_FROM": "",
    "GMAIL_SENDER_ADDRESS": ""
  }
}