# YatraSathi Cloudflare Worker Secrets (Set via `wrangler secret put`, NEVER commit real values)
# Better Auth session/token signing secret (min 32 random chars)
BETTER_AUTH_SECRET="replace-with-random-32-plus-char-secret"

# Used to HMAC-hash email lookups and IP addresses without logging PII
EMAIL_HMAC_SECRET="replace-with-random-32-byte-hex-secret"

# Owner-controlled Gmail API OAuth credentials (scope: https://www.googleapis.com/auth/gmail.send only)
GMAIL_CLIENT_ID="replace-with-google-oauth-client-id"
GMAIL_CLIENT_SECRET="replace-with-google-oauth-client-secret"
GMAIL_REFRESH_TOKEN="replace-with-owner-google-oauth-refresh-token"

# Non-secret vars (configure in wrangler.jsonc [vars] or .dev.vars for local dev)
APP_BASE_URL="http://localhost:8787"
CF_EMAIL_FROM=""
GMAIL_SENDER_ADDRESS="owner@gmail.com"
